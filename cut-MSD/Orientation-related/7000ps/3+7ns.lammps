# ============================================================
# 7000 ps (7 ns) NVT continuation
# 继承上一阶段的速度（nvt_2000ps_gpu.data 中保存的速度）
# Input : nvt_2000ps_gpu.data (equilibrated 300 K, periodic ppp)
# Output: 当前文件夹
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long/gpu 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm/gpu 1e-4

# 读取上一阶段末尾的 data 文件（包含原子坐标和速度，自动继承速度）
read_data       E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_2000ps_gpu.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           SIO2 type 7 8 9
group           FKM  type 1 2 3 4 5 6

timestep        1.0

# 注意：不要重新初始化速度，保持 read_data 读入的速度
# velocity all create 300.0 4928459 dist gaussian   # 不使用
# velocity all zero linear                          # 不使用

fix             nvt all nvt temp 300.0 300.0 100.0

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

# 轨迹输出：每 1000 步一帧（7000 ps 共 7000 帧）
dump            traj all custom 1000 E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_7000ps_traj.dump id type x y z ix iy iz
dump_modify     traj sort id

# 监控输出
variable        tps   equal step*0.001
variable        Tcur  equal temp
variable        PE    equal pe
variable        KE    equal ke
variable        Etot  equal etotal
variable        Pres  equal press
variable        Vol   equal vol
variable        Dens  equal density
fix             mon all print 1000 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Pres} ${Vol} ${Dens}" &
                file E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_7000ps_monitor.txt screen no

# ---- 7000 ps NVT 运行 ----
run             7000000

unfix           nvt

write_restart   E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_7000ps.restart
write_data      E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_7000ps.data
write_dump      all custom E:/A_tools/LAMMPS_GUI/projects/Lammps-MS/FKM-SIO2-TEST/cut-MSD/Orientation-related/7000ps/nvt_7000ps_end.dump id type x y z ix iy iz

print           "NVT 7000 ps continuation finished (inherits velocities from nvt_2000ps_gpu.data)"
