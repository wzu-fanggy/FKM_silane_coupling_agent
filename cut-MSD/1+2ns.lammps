# 2000 ps (2 ns) NVT continuation after 1000 ps (total 3 ns)
# GPU-accelerated version
# Input : cut-MSD/nvt_1000ps_gpu.data (equilibrated 300 K, periodic ppp)
# Output: cut-MSD/nvt_2000ps_gpu_traj.dump (2000 frames)

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long/gpu 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm/gpu 1e-4

read_data       F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_1000ps_gpu.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           SIO2 type 7 8 9
group           FKM type 1 2 3 4 5 6

timestep        1.0

# velocity        all create 300.0 4928459 dist gaussian
# velocity        all zero linear

fix             nvt all nvt temp 300.0 300.0 100.0

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

dump            traj all custom 1000 F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_2000ps_gpu_traj.dump id type x y z ix iy iz
dump_modify     traj sort id

variable        tps equal step*0.001
variable        Tcur equal temp
variable        PE   equal pe
variable        KE   equal ke
variable        Etot equal etotal
variable        Pres equal press
variable        Vol  equal vol
variable        Dens equal density
fix             mon all print 1000 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Pres} ${Vol} ${Dens}" file F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_2000ps_gpu_monitor.txt screen no

run             2000000

unfix           nvt

write_restart   F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_2000ps_gpu.restart
write_data      F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_2000ps_gpu.data
write_dump      all custom F:/Lammps-MS/FKM-SIO2-TEST/cut-MSD/nvt_2000ps_gpu_end.dump id type x y z ix iy iz

print           "NVT 2000 ps multi-frame GPU continuation finished (total 3000 ps)"