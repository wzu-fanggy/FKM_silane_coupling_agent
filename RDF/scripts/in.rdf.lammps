# RDF between FKM and SiO2 via LAMMPS rerun
units           real
atom_style      full
boundary        p p p

package         omp 16
suffix          omp

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       F:/Lammps-MS/FKM-SIO2-TEST/RDF/data/nve_verify.data

group           FKM type 1 2 3 4 5 6
group           SIO2 type 7 8 9

compute         rdfall all rdf 100 1 7 1 8 1 9 2 7 2 8 2 9 3 7 3 8 3 9 4 7 4 8 4 9 5 7 5 8 5 9 6 7 6 8 6 9
fix             av all ave/time 1000 1 1000 c_rdfall[*] ave running mode vector file F:/Lammps-MS/FKM-SIO2-TEST/RDF/outputs/rdf_avg.txt

thermo          1000
thermo_style    custom step

rerun           F:/Lammps-MS/FKM-SIO2-TEST/RDF/traj/last50.dump dump id type x y z ix iy iz box yes

print           "RDF DONE"
