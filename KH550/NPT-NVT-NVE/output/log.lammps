# ============================================================
# KH550 FKM/SiO2 equilibration (server version)
#   NPT 3x200 ps (total 600 ps) -> NVT 500 ps -> NVE 200 ps
# All paths are relative to the current directory.
# Put this script and anneal_final_relabeled_centered.data
# in the same folder.
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       anneal_final_relabeled_centered.data
