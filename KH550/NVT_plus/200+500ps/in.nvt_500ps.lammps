# ============================================================
# KH550 500 ps NVT continuation (1 frame per ps)
# Input : F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_200ps.data
# Output: this folder (200+500ps):
#   nvt_500ps_traj.dump   complete 500-frame dump (every 1000 steps)
#   nvt_500ps_monitor.txt time series
#   nvt_500ps.restart / nvt_500ps.data / nvt_500ps_end.dump
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_200ps.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

timestep        1.0

velocity        all create 300.0 4928459 dist gaussian
velocity        all zero linear

fix             nvt all nvt temp 300.0 300.0 100.0

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

dump            traj all custom 1000 F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_500ps_traj.dump id type x y z ix iy iz
dump_modify     traj sort id

variable        tps  equal step*0.001
variable        Tcur equal temp
variable        PE   equal pe
variable        KE   equal ke
variable        Etot equal etotal
variable        Pres equal press
variable        Vol  equal vol
variable        Dens equal density
fix             mon all print 1000 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Pres} ${Vol} ${Dens}" file F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_500ps_monitor.txt screen no

run             500000

unfix           nvt

write_restart   F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_500ps.restart
write_data      F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_500ps.data
write_dump      all custom F:/Lammps-MS/FKM-SIO2-TEST/KH550/NVT_plus/200+500ps/nvt_500ps_end.dump id type x y z ix iy iz

print           "NVT 500 ps multi-frame production finished"


