neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           sio2   type 6 8 9 10 11 12 13 14
1750 atoms in group sio2
group           matrix type 1 2 3 4 5 7
16080 atoms in group matrix

region          clamp block INF INF INF INF INF -1.207166 units box
group           clamp region clamp
2964 atoms in group clamp
group           clamp subtract clamp sio2
2952 atoms in group clamp
group           mobile subtract matrix clamp
13128 atoms in group mobile

fix             freeze clamp setforce 0 0 0
fix             pull  sio2 move linear 0 0 0.002000
fix             temp  mobile nvt temp 300.0 300.0 100.0
fix             wallz all wall/reflect zlo -26.207165820270379 zhi 308.946481435828787

variable        z0     equal xcm(sio2,z)
variable        disp   equal xcm(sio2,z)-${z0}
variable        disp   equal xcm(sio2,z)-16.1289113308406
compute         fsio   sio2 reduce sum fz
variable        force  equal -c_fsio
compute         gg     sio2 group/group matrix pair yes kspace yes
variable        egg    equal c_gg
fix             out all print 200 "$(step) $(v_disp) $(v_force) $(v_egg)"                 file force_curve.txt screen no

dump            traj all custom 200 traj.dump id type x y z vx vy vz ix iy iz
dump_modify     traj sort id
dump_modify     traj flush yes

thermo          1000
thermo_style    custom step temp pe press v_disp v_force

timestep        1.0
run             50000

