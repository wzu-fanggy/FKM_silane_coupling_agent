# ============================================================
# KH550/FKM/SiO2 RDF via LAMMPS rerun
# Mirrors: KH570/RDF/scripts/in.rdf.lammps
#
# Atom types (PCFF labels, relabeled KH550 data):
#   FKM : c(1) c1(2) c2(3) c3(4) f(5) hc(7)
#   SIO2 (KH550-grafted): h*(6) hn2(8) na(9) o(10)
#                         si(11) c2_KH550(12)
#                         c3_KH550(13) hc_KH550(14)
# Types 12/13/14 are relabeled copies of the KH550 linker
# c2/c3/hc atoms, so FKM and grafted SiO2 no longer share types.
#
# Run from F:\Lammps-MS\FKM-SIO2-TEST\KH550\RDF:
#   lmp -in scripts/in.rdf.lammps
# Trajectory: traj/last50.dump (50 frames, fields id type x y z ix iy iz)
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       F:/Lammps-MS/FKM-SIO2-TEST/KH550/RDF/data/nvt_200ps.data

group           FKM type 1 2 3 4 5 7
group           SIO2 type 6 8 9 10 11 12 13 14

compute         rdfall all rdf 100 &
                  1 6 1 8 1 9 1 10 1 11 1 12 1 13 1 14 &
                  2 6 2 8 2 9 2 10 2 11 2 12 2 13 2 14 &
                  3 6 3 8 3 9 3 10 3 11 3 12 3 13 3 14 &
                  4 6 4 8 4 9 4 10 4 11 4 12 4 13 4 14 &
                  5 6 5 8 5 9 5 10 5 11 5 12 5 13 5 14 &
                  7 6 7 8 7 9 7 10 7 11 7 12 7 13 7 14
fix             av all ave/time 1000 1 1000 c_rdfall[*] ave running mode vector file F:/Lammps-MS/FKM-SIO2-TEST/KH550/RDF/outputs/rdf_avg.txt

thermo          1000
thermo_style    custom step

rerun           F:/Lammps-MS/FKM-SIO2-TEST/KH550/RDF/traj/last50.dump dump id type x y z ix iy iz box yes

print           "RDF DONE"
