# ============================================================
# 100 ps NVT surface relaxation after adding 250 A z-vacuum
# Input : nvt_2000ps_gpu_centered_vacuum250.data (same dir)
# Output: nvt_100ps_traj.dump (every 1000 steps)
#         nvt_100ps_relaxed.data
# Setup : p p f + pppm slab + reflecting walls
#         bottom 25 A FKM clamped, everything else NVT 300 K
# ============================================================

units           real
atom_style      full
boundary        p p f

pair_style      lj/class2/coul/long 15.5
kspace_style    pppm 1e-4
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1

read_data       nvt_2000ps_gpu_centered_vacuum250.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# ---- groups ----
# SiO2: ho(7) o(8) si(9)  ;  FKM: c(1) c1(2) c2(3) c3(4) f(5) hc(6)
group           sio2   type 7 8 9
group           matrix type 1 2 3 4 5 6

# bottom 25 A FKM layer stays fixed so the slab cannot drift
region          clamp block INF INF INF INF INF 46.2 units box
group           clamp region clamp
group           clamp subtract clamp sio2

group           mobile subtract all clamp

# ---- constraints and thermostat ----
fix             freeze clamp setforce 0 0 0
fix             temp  mobile nvt temp 300.0 300.0 100.0
fix             wallz all wall/reflect zlo 21.200175560556755 zhi 351.196020318334604

# ---- monitoring ----
variable        zcom   equal xcm(sio2,z)
variable        zfkm   equal xcm(mobile,z)
variable        step   equal step

thermo          1000
thermo_style    custom step temp pe press v_zcom v_zfkm

# ---- trajectory every 1000 steps ----
dump            traj all custom 1000 nvt_100ps_traj.dump id type x y z vx vy vz ix iy iz
dump_modify     traj sort id
dump_modify     traj flush yes

timestep        1.0
run             100000

write_data      nvt_100ps_relaxed.data
print           ">>> 100 ps NVT surface relaxation completed."
