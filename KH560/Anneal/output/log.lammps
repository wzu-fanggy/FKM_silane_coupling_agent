variable        i loop 10
label           shortloop

fix             anneal_up all nvt temp ${Tlo} ${Thi} ${tdamp_fast}
fix             anneal_up all nvt temp 263 ${Thi} ${tdamp_fast}
fix             anneal_up all nvt temp 263 573 ${tdamp_fast}
fix             anneal_up all nvt temp 263 573 500
run             10000
