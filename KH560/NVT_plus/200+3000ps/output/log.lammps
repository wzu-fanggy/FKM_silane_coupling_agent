neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

timestep        1.0

velocity        all create 300.0 4928459 dist gaussian
velocity        all zero linear

fix             nvt all nvt temp 300.0 300.0 100.0

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

dump            traj all custom 1000 nvt_3000ps_traj.dump id type x y z ix iy iz
dump_modify     traj sort id

variable        tps  equal step*0.001
variable        Tcur equal temp
variable        PE   equal pe
variable        KE   equal ke
variable        Etot equal etotal
variable        Pres equal press
variable        Vol  equal vol
variable        Dens equal density
fix             mon all print 1000 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Pres} ${Vol} ${Dens}" file nvt_3000ps_monitor.txt screen no

run             3000000

