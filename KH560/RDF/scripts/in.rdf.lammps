# ============================================================
# KH560/FKM/SiO2 RDF via LAMMPS rerun
# Mirrors: in.rdf.lammps for the grafted FKM/SiO2 layout
#
# Atom types (PCFF labels, relabeled KH560 data):
#   FKM : c(1) c1(2) c2(3) c3(4) f(6) hc(8)
#   SIO2 (KH560-grafted): c3h(5) h*(7) o(9) o3e(10)
#                         oc(11) si(12) c2_KH560(13)
#                         c3_KH560(14) hc_KH560(15)
# Types 13/14/15 are relabeled copies of the KH560 linker
# c2/c3/hc atoms, so FKM and grafted SiO2 no longer share types.
#
# Run from F:\Lammps-MS\FKM-SIO2-TEST\KH560\RDF:
#   lmp -in scripts/in.rdf.lammps
# Trajectory: traj/last50.dump (50 frames, fields id type x y z ix iy iz)
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       F:/Lammps-MS/FKM-SIO2-TEST/KH560/RDF/data/nvt_200ps.data

group           FKM type 1 2 3 4 6 8
group           SIO2 type 5 7 9 10 11 12 13 14 15

compute         rdfall all rdf 100 &
                  1 5 1 7 1 9 1 10 1 11 1 12 1 13 1 14 1 15 &
                  2 5 2 7 2 9 2 10 2 11 2 12 2 13 2 14 2 15 &
                  3 5 3 7 3 9 3 10 3 11 3 12 3 13 3 14 3 15 &
                  4 5 4 7 4 9 4 10 4 11 4 12 4 13 4 14 4 15 &
                  6 5 6 7 6 9 6 10 6 11 6 12 6 13 6 14 6 15 &
                  8 5 8 7 8 9 8 10 8 11 8 12 8 13 8 14 8 15
fix             av all ave/time 1000 1 1000 c_rdfall[*] ave running mode vector file F:/Lammps-MS/FKM-SIO2-TEST/KH560/RDF/outputs/rdf_avg.txt

thermo          1000
thermo_style    custom step

rerun           F:/Lammps-MS/FKM-SIO2-TEST/KH560/RDF/traj/last50.dump dump id type x y z ix iy iz box yes

print           "RDF DONE"
