# ============================================================
# FKM/SiO2 annealing: short NVT + long NPT (cubic box)
# Temp: 263 K -> 573 K -> 263 K
# Long cycles use NPT iso 1 atm, box stays cubic
# Run: cd Anneal && lmp -in anneal.lammps
# Input : use-op-2.data (same directory)
# Output: current directory
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       use-op-2.data
Reading data file ...
  orthogonal box = (0 0 0) to (100 100 100)
  2 by 4 by 4 MPI processor grid
  reading atom labelmap ...
  reading bond labelmap ...
  reading angle labelmap ...
  reading dihedral labelmap ...
  reading improper labelmap ...
  reading atoms ...
  17550 atoms
  reading velocities ...
  17550 velocities
  scanning bonds ...
  4 = max bonds/atom
  scanning angles ...
  6 = max angles/atom
  scanning dihedrals ...
  21 = max dihedrals/atom
  scanning impropers ...
  4 = max impropers/atom
  orthogonal box = (0 0 0) to (100 100 100)
  2 by 4 by 4 MPI processor grid
  reading bonds ...
  17692 bonds
  reading angles ...
  34802 angles
  reading dihedrals ...
  50952 dihedrals
  reading impropers ...
  22624 impropers
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     4 = max # of 1-2 neighbors
     9 = max # of 1-3 neighbors
    13 = max # of special neighbors
  special bonds CPU = 0.014 seconds
  read_data CPU = 1.013 seconds

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

variable        Tlo      equal 263.0
variable        Thi      equal 573.0
variable        tdamp_fast equal 500.0
variable        tdamp_slow equal 1000.0
variable        tdamp_eq   equal 500.0
# Polymer systems: 1000-5000 fs is common; 5000 fs is more stable
variable        pdamp      equal 5000.0

velocity        all create ${Tlo} 4928459 dist gaussian
velocity        all create 263 4928459 dist gaussian

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density lx ly lz

# Box/density monitor: instantaneous Lx/Ly/Lz, volume and density
variable        Lx      equal lx
variable        Ly      equal ly
variable        Lz      equal lz
variable        Vol     equal vol
variable        Dens    equal density
variable        Step    equal step
fix             boxmon  all print 1000 "${Step} ${Lx} ${Ly} ${Lz} ${Vol} ${Dens}" file box_density_monitor.txt screen no

# ---- Phase 1: initial NVT equilibration ----
timestep        0.5
fix             init_eq all nvt temp ${Tlo} ${Tlo} ${tdamp_eq}
fix             init_eq all nvt temp 263 ${Tlo} ${tdamp_eq}
fix             init_eq all nvt temp 263 263 ${tdamp_eq}
fix             init_eq all nvt temp 263 263 500
run             20000

