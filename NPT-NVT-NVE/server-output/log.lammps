Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     4 = max # of 1-2 neighbors
     9 = max # of 1-3 neighbors
    13 = max # of special neighbors
  special bonds CPU = 0.014 seconds
  read_data CPU = 1.086 seconds

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

variable        T      equal 300.0
variable        tdamp  equal 100.0
variable        pdamp  equal 5000.0

velocity        all create ${T} 4928459 dist gaussian
velocity        all create 300 4928459 dist gaussian
velocity        all zero linear

timestep        1.0
thermo          1000
thermo_style    custom step temp pe ke etotal press vol density lx ly lz

# Box/density monitor in the same directory
variable        Step   equal step
variable        Lx     equal lx
variable        Ly     equal ly
variable        Lz     equal lz
variable        Vol    equal vol
variable        Dens   equal density
fix             boxmon all print 1000 "${Step} ${Lx} ${Ly} ${Lz} ${Vol} ${Dens}" file box_density_monitor.txt screen no

# ---- NPT: 3 cycles x 200 ps (total 600 ps) ----
variable        j loop 3
label           nptloop

fix             equil all npt temp ${T} ${T} ${tdamp} iso 1.0 1.0 ${pdamp}
fix             equil all npt temp 300 ${T} ${tdamp} iso 1.0 1.0 ${pdamp}
fix             equil all npt temp 300 300 ${tdamp} iso 1.0 1.0 ${pdamp}
fix             equil all npt temp 300 300 100 iso 1.0 1.0 ${pdamp}
fix             equil all npt temp 300 300 100 iso 1.0 1.0 5000
run             200000

