# ============================================================
# FKM/SiO2 constant-velocity SMD pull-out along +z (final)
# Input : pull_equil.data (same directory)
# Output: pull_monitor.txt, pull_traj.dump, pull_end.*
# Full run: Nrun = 600000 (600 ps, ~60 A at 1e-4 A/fs)
# Local smoke test: lmp -in in.pull_smd.lammps -var Nrun 100
# ============================================================

units           real
atom_style      full
boundary        p p f

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4
kspace_modify   slab 3.0

read_data       pull_equil.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# ---- groups --------------------------------------------------
group           SIO2 type 7 8 9
group           FKM type 1 2 3 4 5 6
region          anchor_region block INF INF INF INF 0.0 20.0
group           anchor region anchor_region
group           anchor subtract anchor SIO2

# ---- SMD parameters ------------------------------------------
variable        T      equal 300.0
variable        tdamp  equal 100.0
variable        K      equal 100.0
variable        vpull  equal 1.0e-4
variable        Nrun   index 600000

fix             nve_sio2 SIO2 nve
fix             nvt_matrix FKM nvt temp ${T} ${T} ${tdamp}
fix             anchor_spring anchor spring/self 5.0
fix             pull SIO2 smd cvel ${K} ${vpull} tether NULL NULL 0.0 0.0
fix_modify      pull virial yes

# ---- monitoring: no mass/volume, SiO2 x/y/z included ---------
variable        tps   equal step*0.001
variable        Tcur  equal temp
variable        PE    equal pe
variable        KE    equal ke
variable        Etot  equal etotal
variable        Press equal press
variable        xsio2 equal xcm(SIO2,x)
variable        ysio2 equal xcm(SIO2,y)
variable        zsio2 equal xcm(SIO2,z)
variable        fp1   equal f_pull[1]
variable        fp2   equal f_pull[2]
variable        fp3   equal f_pull[3]
variable        fp4   equal f_pull[4]
variable        fp6   equal f_pull[6]
variable        fp7   equal f_pull[7]

thermo          1000
thermo_style    custom step v_tps temp pe ke etotal press v_xsio2 v_ysio2 v_zsio2 f_pull[1] f_pull[2] f_pull[3] f_pull[4] f_pull[6] f_pull[7]

fix             monitor all print 100 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Press} ${xsio2} ${ysio2} ${zsio2} ${fp1} ${fp2} ${fp3} ${fp4} ${fp6} ${fp7}" file pull_monitor.txt screen no

dump            traj all custom 5000 pull_traj.dump id type x y z ix iy iz

run             ${Nrun}

undump          traj
write_restart   pull_end.restart
write_data      pull_end.data
write_dump      all custom pull_end.dump id type x y z ix iy iz

print           "SMD pull-out finished."
