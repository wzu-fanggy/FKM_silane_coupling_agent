# Single-velocity FKM-SiO2 pullout, controlled by Python.
# Pass on the command line:
#   -var velZ 0.050   (A/fs, i.e. 50 A/ps)
#   -var tag  kick50Aps
#   -var chunk 1000   (steps per monitor/dump interval)
# Python rewrites ctrl.inc to set stop = 1 (done) or stop = 2 (abandon).

units           real
atom_style      full
boundary        p p f

package         omp 16
suffix          omp

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4
kspace_modify   slab 3.0

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

read_data       F:/Lammps-MS/FKM-SIO2-TEST/pull/NEW/sci/pull_equil_600Aadd.data

group           SIO2 type 7 8 9
group           FKM type 1 2 3 4 5 6

compute         gg FKM group/group SIO2 pair yes kspace yes
compute         zmax all reduce max z

variable        zmt equal c_zmax
variable        eabs0 equal abs(c_gg)

timestep        0.5
velocity        SIO2 set 0.0 0.0 ${velZ}
fix             nve all nve

variable        tps equal step*0.0005
variable        zs equal xcm(SIO2,z)
variable        eabs equal abs(c_gg)

thermo          1000
thermo_style    custom step v_tps v_zs v_eabs
run             0

variable        Z0 equal ${zmt}
variable        E0 equal ${eabs}

dump            traj all custom ${chunk} ${tag}_traj.dump id type x y z ix iy iz
fix             monitor all print ${chunk} "${tps} ${zs} ${eabs}" file ${tag}_monitor.txt screen no

print           "READY ${tag} Z0=${Z0} E0=${E0}"

variable        i loop 1000000
variable        stop equal 0
label           run_loop

run             ${chunk}
include         ctrl.inc
if "$(v_stop == 1)" then "jump SELF done"
if "$(v_stop == 2)" then "jump SELF abandon"

next            i
jump            SELF run_loop

label           hard_stop

write_data      ${tag}_end_abandoned.data
write_restart   ${tag}_end_abandoned.restart
write_dump      all custom ${tag}_end_abandoned.dump id type x y z ix iy iz
print           "HARD_STOP ${tag} zdist=$(v_zs-v_Z0) Eabs=${eabs}" file ${tag}_status.txt

jump            SELF finish

label           done

write_data      ${tag}_end_converged.data
write_restart   ${tag}_end_converged.restart
write_dump      all custom ${tag}_end_converged.dump id type x y z ix iy iz
print           "CONVERGED ${tag} zdist=$(v_zs-v_Z0) Eabs=${eabs}" file ${tag}_status.txt

jump            SELF finish

label           abandon

write_data      ${tag}_end_abandoned.data
write_restart   ${tag}_end_abandoned.restart
write_dump      all custom ${tag}_end_abandoned.dump id type x y z ix iy iz
print           "ABANDONED ${tag} zdist=$(v_zs-v_Z0) Eabs=${eabs}" file ${tag}_status.txt

jump            SELF finish

label           finish

print           "FINISHED ${tag}"
