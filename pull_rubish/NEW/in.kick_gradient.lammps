# MS-style kick gradient in ONE LAMMPS input
# dt = 0.5 fs, each velocity runs 8 ps (16000 steps) from pull_equil.data
# Outputs: kick_15Aps_monitor.txt, kick_15Aps_end.data, ...

variable        velZ index 0.015 0.017 0.019 0.021 0.023 0.025 0.027 0.029
variable        tag  index kick_15Aps kick_17Aps kick_19Aps kick_21Aps kick_23Aps kick_25Aps kick_27Aps kick_29Aps
variable        Nrun index 16000

label           loop

clear

units           real
atom_style      full
boundary        p p f

package         omp 16
suffix          omp

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4
kspace_modify   slab 3.0

read_data       pull_equil.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           SIO2 type 7 8 9
group           FKM type 1 2 3 4 5 6

timestep        0.5

velocity        SIO2 set 0.0 0.0 ${velZ}

fix             nve all nve

variable        tps   equal step*0.0005
variable        Tcur  equal temp
variable        PE    equal pe
variable        KE    equal ke
variable        Etot  equal etotal
variable        zsio2 equal xcm(SIO2,z)
variable        zfkm  equal xcm(FKM,z)
variable        zsep  equal xcm(SIO2,z)-xcm(FKM,z)

thermo          1000
thermo_style    custom step v_tps temp pe ke etotal v_zsio2 v_zfkm v_zsep

fix             monitor all print 500 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${zsio2} ${zfkm} ${zsep}" file ${tag}_monitor.txt screen no

dump            traj all custom 1000 ${tag}_traj.dump id type x y z ix iy iz

run             ${Nrun}

undump          traj
unfix           nve

write_restart   ${tag}_end.restart
write_data      ${tag}_end.data
write_dump      all custom ${tag}_end.dump id type x y z ix iy iz

print           "Kick ${tag} finished."

next            velZ
next            tag
jump            SELF loop
