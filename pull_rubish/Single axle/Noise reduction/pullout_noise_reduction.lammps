# ============================================================
# SiO2 pull-out from FKM along +Z, noise-reduced version
# - pull velocity: 0.015 A/fs (15 A/ps)
#   -> 100 A in 6667 fs (6.67 ps, timestep 1.0 fs)
# - raw force every 20 steps  -> pullout_raw.txt
# - 0.2 ps time-averaged force -> pullout_smooth.txt
#   (fix ave/time: sample 20 steps x 10 = 200 steps window)
# - full trajectory every 100 steps, with vx vy vz ix iy iz
# Clamp: bottom 10 A FKM layer, NVT 300 K on mobile FKM
# Input : nvt_2000ps_gpu_vacuum200.data (same directory)
# Z is non-periodic (p p f) + slab kspace + reflecting walls,
# so FKM cannot wrap into the vacuum at the box top.
# ============================================================

units           real
atom_style      full
boundary        p p f

pair_style      lj/class2/coul/long 15.5
kspace_style    pppm 1e-4
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1

read_data       nvt_2000ps_gpu_vacuum200.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# ---- groups ----
# SiO2: ho(7) o(8) si(9)  ;  FKM: c(1) c1(2) c2(3) c3(4) f(5) hc(6)
group           sio2   type 7 8 9
group           matrix type 1 2 3 4 5 6

# clamp = bottom 25 A layer of FKM (z from 21.2 to 46.2).
# FKM consists of 120 independent chains: a thin clamp lets the whole
# matrix drift with SiO2, so the clamp is kept thick.
region          clamp block INF INF INF INF INF 46.2 units box
group           clamp region clamp
group           clamp subtract clamp sio2

group           mobile subtract matrix clamp

# ---- constraints ----
fix             freeze clamp setforce 0 0 0
fix             pull  sio2 move linear 0 0 0.015
fix             temp  mobile nvt temp 300.0 300.0 100.0
fix             wallz all wall/reflect zlo 21.200175560556755 zhi 300.86633656055676

# ---- force signal ----
compute         fsio   sio2 reduce sum fz
variable        force_inst equal -c_fsio      # positive pull force

variable        z0     equal xcm(sio2,z)
variable        zcom   equal xcm(sio2,z)
variable        zfkm   equal xcm(mobile,z)
variable        step   equal step
variable        disp   equal xcm(sio2,z)-${z0}

# ---- output 1: raw instantaneous force, every 20 steps ----
fix             outraw all print 20 "$(step) $(v_disp) $(v_force_inst) $(v_zfkm)" &
                file pullout_raw.txt screen no

# ---- output 2: 0.2 ps time-averaged force (sample 20, N 10, window 200) ----
fix             avef all ave/time 20 10 200 v_force_inst &
                file pullout_smooth.txt mode scalar

# ---- trajectory ----
dump            traj all custom 100 pullout_traj.dump id type x y z vx vy vz ix iy iz
dump_modify     traj sort id
dump_modify     traj flush yes

thermo          200
thermo_style    custom step temp pe press v_zcom v_zfkm v_force_inst

timestep        1.0
run             6667

write_data      pullout_end.data
print           ">>> Pull-out (noise-reduced) 100 A completed at 0.015 A/fs."
