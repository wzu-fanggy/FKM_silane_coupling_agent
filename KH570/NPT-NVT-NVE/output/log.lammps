# ============================================================
# FKM/SiO2 equilibration: NPT 3x200 ps (total 600 ps) -> NVT 500 ps -> NVE 200 ps
# Input : anneal_final.data (当前文件夹)
# Random 300 K velocities before NPT, current velocities after
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

read_data       anneal_final.data  # 改为当前文件夹路径
