# LAMMPS CG minimization for all.pdb (KH570 + SiO2), PCFF/class2
# generated by LUNAR atom_typing + all2lmp

units        real
atom_style   full
boundary     p p p

pair_style   lj/class2/coul/long 10.0
kspace_style pppm 1.0e-4
bond_style   class2
angle_style  class2
dihedral_style class2
improper_style class2

special_bonds lj/coul 0 0 1
pair_modify  tail yes mix sixthpower

read_data    all2lmp_out/all_typed_PCFF.data

# CG (conjugate gradient) minimization
minimize     1.0e-4 1.0e-6 1000 10000

write_data   minimized_all.data
print        "CG minimization completed"
