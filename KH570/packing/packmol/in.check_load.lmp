units        real
atom_style   full
boundary     p p p
pair_style   lj/class2/coul/long 10.0
kspace_style pppm 1.0e-4
bond_style   class2
angle_style  class2
dihedral_style class2
improper_style class2
special_bonds lj/coul 0 0 1
pair_modify  tail yes mix sixthpower
read_data    all2lmp_out/KH570-SIO2-FKM-150A-120chains_typed_PCFF.data
run          0
print        "data file loads OK"
