  orthogonal box = (-27.641569 -31.916141 -24.023616) to (30.94185 26.852966 315.21757)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  17992 bonds
  reading angles ...
  35342 angles
  reading dihedrals ...
  51562 dihedrals
  reading impropers ...
  22934 impropers
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     4 = max # of 1-2 neighbors
     9 = max # of 1-3 neighbors
    13 = max # of special neighbors
  special bonds CPU = 0.004 seconds
  read_data CPU = 0.510 seconds

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           sio2   type 5 6 7 9 11 12 13 14 15 16 17
1770 atoms in group sio2
group           matrix type 1 2 3 4 8 10
16080 atoms in group matrix

region          clamp block INF INF INF INF INF 0.976384 units box
group           clamp region clamp
2759 atoms in group clamp
group           clamp subtract clamp sio2
2759 atoms in group clamp
group           mobile subtract matrix clamp
13321 atoms in group mobile

fix             freeze clamp setforce 0 0 0
fix             pull  sio2 move linear 0 0 0.015000
fix             temp  mobile nvt temp 300.0 300.0 100.0
fix             wallz all wall/reflect zlo -24.023615747639855 zhi 315.217567440135326

variable        z0     equal xcm(sio2,z)
variable        disp   equal xcm(sio2,z)-${z0}
variable        disp   equal xcm(sio2,z)-21.2889383447993
compute         fsio   sio2 reduce sum fz
variable        force  equal -c_fsio
compute         gg     sio2 group/group matrix pair yes kspace yes
variable        egg    equal c_gg
fix             out all print 200 "$(step) $(v_disp) $(v_force) $(v_egg)"                 file force_curve.txt screen no

dump            traj all custom 200 traj.dump id type x y z vx vy vz ix iy iz
dump_modify     traj sort id
dump_modify     traj flush yes

thermo          1000
thermo_style    custom step temp pe press v_disp v_force

timestep        0.5
run             13333

