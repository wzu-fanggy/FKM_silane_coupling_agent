# ============================================================
# 7000 ps (7 ns) NVT continuation (KH570 system)
# Inherits velocities from nvt_3000ps.data (Velocities section)
# Input : nvt_3000ps.data (equilibrated 300 K, periodic ppp)
# Output: current working directory
# CPU version (no GPU package required)
# ============================================================

units           real
atom_style      full
boundary        p p p

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4

# Read the final data file from the previous stage
# (coordinates AND velocities are loaded automatically -> velocities inherited)
read_data       nvt_3000ps.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           SIO2 type 7 8 9
group           FKM  type 1 2 3 4 5 6

timestep        1.0

# Do NOT re-initialize velocities; keep those read from the data file
# velocity all create 300.0 4928459 dist gaussian   # not used
# velocity all zero linear                          # not used

fix             nvt all nvt temp 300.0 300.0 100.0

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

# Trajectory output: one frame every 1000 steps (7000 frames in total)
dump            traj all custom 1000 nvt_7000ps_traj.dump id type x y z ix iy iz
dump_modify     traj sort id

# Thermodynamic monitor output
variable        tps   equal step*0.001
variable        Tcur  equal temp
variable        PE    equal pe
variable        KE    equal ke
variable        Etot  equal etotal
variable        Pres  equal press
variable        Vol   equal vol
variable        Dens  equal density
fix             mon all print 1000 "${tps} ${Tcur} ${PE} ${KE} ${Etot} ${Pres} ${Vol} ${Dens}" &
                file nvt_7000ps_monitor.txt screen no

# ---- 7000 ps NVT run ----
run             7000000

unfix           nvt

write_restart   nvt_7000ps.restart
write_data      nvt_7000ps.data
write_dump      all custom nvt_7000ps_end.dump id type x y z ix iy iz

print           "NVT 7000 ps continuation finished (velocities inherited from nvt_3000ps.data)"
