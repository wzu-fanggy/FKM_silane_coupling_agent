# Geometry analysis for SiO2 sphere
# Reads the equilibrated data file and writes atom coordinates for Python.
# Run from the Geometry folder:
#   lmp -in in.geometry.lammps

units           real
atom_style      full
boundary        p p f

pair_style      lj/class2/coul/long 15.5
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1e-4
kspace_modify   slab 3.0

read_data       pull_equil/pull_equil.data

group           SIO2 type 7 8 9
group           FKM type 1 2 3 4 5 6

compute         SIO2COM SIO2 com
compute         SIO2RG SIO2 gyration

variable        xc equal c_SIO2COM[1]
variable        yc equal c_SIO2COM[2]
variable        zc equal c_SIO2COM[3]
variable        rg equal c_SIO2RG

thermo          1
thermo_style    custom step

run             0

print           "GEOMETRY_SUMMARY Rg=${rg} COMX=${xc} COMY=${yc} COMZ=${zc}" file geometry_lammps_summary.txt
write_dump      all custom geometry_atoms.dump id type x y z ix iy iz

print           "Geometry dump finished."
